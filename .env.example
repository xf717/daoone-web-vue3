# 仅供 Nuxt 服务端读取。生产环境由部署系统注入，npm start 不自动读取 .env。
NUXT_BACKEND_BASE_URL=http://127.0.0.1:48080/app-api/
NUXT_BACKEND_API_TIMEOUT_MS=10000
# 按实际 Member API 的租户配置填写，不默认冒用租户。
NUXT_MEMBER_TENANT_ID=
# 写请求来源校验使用公开站点的完整 origin，不包含路径。
NUXT_PUBLIC_ORIGIN=http://localhost:3000
# 启用认证接口前生成至少 32 字符的随机密钥，各实例必须一致。
NUXT_SESSION_PASSWORD=
